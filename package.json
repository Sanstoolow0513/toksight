{
  "name": "toksight",
  "version": "1.0.0",
  "description": "Track token usage, cost and cache hit rate of AI coding agents (ZCode, Claude Code, Codex, OpenCode, Kimi Code, Cursor) from your terminal.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "toksight": "bin/toksight.js"
  },
  "files": [
    "bin",
    "src",
    "web/out",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "smoke": "node bin/toksight.js",
    "web:install": "npm install --prefix web",
    "web:ci": "npm ci --prefix web",
    "web:dev": "node scripts/web-dev.js",
    "web:dev:ui": "npm run dev --prefix web",
    "web:build": "node scripts/web-build.js",
    "check:package": "node scripts/check-package.js",
    "release:version": "node scripts/release-version.js",
    "prepack": "npm run web:ci && npm run web:build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "token",
    "usage",
    "cost",
    "claude-code",
    "codex",
    "opencode",
    "zcode",
    "cursor",
    "cli",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanstoolow0513/toksight.git"
  },
  "homepage": "https://github.com/Sanstoolow0513/toksight#readme",
  "bugs": {
    "url": "https://github.com/Sanstoolow0513/toksight/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
