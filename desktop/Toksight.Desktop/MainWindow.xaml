<Window x:Class="Toksight.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource BgBrush}">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE80A;" Foreground="{ThemeResource SignalBrush}" FontSize="22"/>
                <TextBlock Text="toksight" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="TitleActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Click="ExportClick" AutomationProperties.Name="Export report image" ToolTipService.ToolTip="Export PNG"><FontIcon Glyph="&#xE792;" FontSize="16"/></Button>
                <Button x:Name="RefreshButton" Click="RefreshClick" AutomationProperties.Name="Refresh usage" ToolTipService.ToolTip="Refresh"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
                <Button x:Name="ThemeButton" Click="ThemeClick" AutomationProperties.Name="Change appearance" ToolTipService.ToolTip="Appearance"><FontIcon Glyph="&#xE708;" FontSize="16"/></Button>
                <Button x:Name="LanguageButton" Click="LanguageClick" AutomationProperties.Name="Change language" ToolTipService.ToolTip="简体中文 / English"><FontIcon Glyph="&#xE8C1;" FontSize="16"/></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="Rail" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,20,12,12">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="InsightsLabel" Margin="12,0,0,8" FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    <Button x:Name="TodayButton" Click="TodayClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D9;" FontSize="17"/><TextBlock x:Name="TodayLabel"/></StackPanel>
                    </Button>
                    <Button x:Name="CalendarButton" Click="CalendarClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE787;" FontSize="17"/><TextBlock x:Name="CalendarLabel"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="WorkspaceLabel" Margin="12,24,0,8" FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    <Button x:Name="PricesButton" Click="PricesClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8D4;" FontSize="17"/><TextBlock x:Name="PricesLabel"/></StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Click="SettingsClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="17"/><TextBlock x:Name="SettingsLabel"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="12" Margin="12,20,8,4">
                    <TextBlock x:Name="LocalNote" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    <TextBlock x:Name="ZoneLabel" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    <TextBlock Text="WinUI 3 · exp" FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <StackPanel x:Name="StartupPanel" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="28">
                    <ProgressRing x:Name="StartupRing" IsActive="True" Width="36" Height="36"/>
                    <TextBlock x:Name="StartupText" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button x:Name="RetryButton" Click="RetryClick" Content="Retry" Visibility="Collapsed" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Informational"/>
    </Grid>
</Window>
