<Window x:Class="Toksight.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource BgBrush}">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0,150,0">
            <Button x:Name="BrandButton" Click="TodayClick" Style="{StaticResource GhostIconButtonStyle}" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="toksight" />
            <StackPanel x:Name="TitleActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Click="ExportClick" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Export report image" ToolTipService.ToolTip="Export PNG" />
                <Button x:Name="RefreshButton" Click="RefreshClick" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Refresh usage" ToolTipService.ToolTip="Refresh" />
                <Border x:Name="ActionsDivider" Width="1" Height="20" Background="{ThemeResource LineBrush}" Margin="4,0" />
                <Button x:Name="ThemeButton" Click="ThemeClick" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Change appearance" ToolTipService.ToolTip="Appearance" />
                <Button x:Name="LanguageButton" Click="LanguageClick" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Change language" ToolTipService.ToolTip="简体中文 / English" />
                <Button x:Name="GitHubButton" Click="GitHubClick" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="GitHub" ToolTipService.ToolTip="GitHub" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="Rail" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,16,12,16">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="InsightsLabel" Margin="12,0,0,6" FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    <Button x:Name="TodayButton" Click="TodayClick" Style="{StaticResource RailButtonStyle}">
                        <Grid><Border x:Name="TodayMarker" Width="3" Height="20" Background="{ThemeResource SignalBrush}" CornerRadius="0,2,2,0" HorizontalAlignment="Left" Margin="-12,0,0,0" Opacity="0"/><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><ContentControl x:Name="TodayIcon" VerticalAlignment="Center"/><TextBlock x:Name="TodayLabel" VerticalAlignment="Center"/></StackPanel></Grid>
                    </Button>
                    <Button x:Name="CalendarButton" Click="CalendarClick" Style="{StaticResource RailButtonStyle}">
                        <Grid><Border x:Name="CalendarMarker" Width="3" Height="20" Background="{ThemeResource SignalBrush}" CornerRadius="0,2,2,0" HorizontalAlignment="Left" Margin="-12,0,0,0" Opacity="0"/><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><ContentControl x:Name="CalendarIcon" VerticalAlignment="Center"/><TextBlock x:Name="CalendarLabel" VerticalAlignment="Center"/></StackPanel></Grid>
                    </Button>
                    <TextBlock x:Name="WorkspaceLabel" Margin="12,24,0,6" FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    <Button x:Name="PricesButton" Click="PricesClick" Style="{StaticResource RailButtonStyle}">
                        <Grid><Border x:Name="PricesMarker" Width="3" Height="20" Background="{ThemeResource SignalBrush}" CornerRadius="0,2,2,0" HorizontalAlignment="Left" Margin="-12,0,0,0" Opacity="0"/><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><ContentControl x:Name="PricesIcon" VerticalAlignment="Center"/><TextBlock x:Name="PricesLabel" VerticalAlignment="Center"/></StackPanel></Grid>
                    </Button>
                    <Button x:Name="SettingsButton" Click="SettingsClick" Style="{StaticResource RailButtonStyle}">
                        <Grid><Border x:Name="SettingsMarker" Width="3" Height="20" Background="{ThemeResource SignalBrush}" CornerRadius="0,2,2,0" HorizontalAlignment="Left" Margin="-12,0,0,0" Opacity="0"/><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><ContentControl x:Name="SettingsIcon" VerticalAlignment="Center"/><TextBlock x:Name="SettingsLabel" VerticalAlignment="Center"/></StackPanel></Grid>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="12" Margin="0,20,0,0">
                    <Border x:Name="PrivacyCard" Background="{ThemeResource Surface2Brush}" CornerRadius="6" Padding="12">
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ContentControl x:Name="PrivacyIcon" Margin="0,2,0,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="PrivacyTitle" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource SubtleBrush}"/><TextBlock x:Name="LocalNote" TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
                        </Grid>
                    </Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="ZoneButton" Click="SettingsClick" Style="{StaticResource GhostButtonStyle}" Padding="4,0" MinHeight="28" HorizontalContentAlignment="Left"><TextBlock x:Name="ZoneLabel" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/></Button>
                        <Button x:Name="CollapseButton" Click="CollapseClick" Grid.Column="1" Style="{StaticResource GhostIconButtonStyle}" Width="28" Height="28" MinWidth="28" MinHeight="28"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <StackPanel x:Name="StartupPanel" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="28">
                    <ProgressRing x:Name="StartupRing" IsActive="True" Width="36" Height="36"/>
                    <TextBlock x:Name="StartupText" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button x:Name="RetryButton" Click="RetryClick" Content="Retry" Visibility="Collapsed" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Informational"/>
    </Grid>
</Window>
