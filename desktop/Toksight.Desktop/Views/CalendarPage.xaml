<UserControl x:Class="Toksight.Desktop.Views.CalendarPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CalendarToolButton" TargetType="Button">
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource Surface3Brush}"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource Surface2Brush}"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CalendarCellButton" TargetType="Button">
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SignalBrush}"/><Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource SurfaceBrush}"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/><Setter Property="FocusVisualSecondaryThickness" Value="1"/><Setter Property="FocusVisualMargin" Value="-3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverFrame.Opacity" Value="1"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverFrame.Opacity" Value="1"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                    <Border x:Name="HoverFrame" BorderBrush="{ThemeResource SignalBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageRoot" Background="{ThemeResource BgBrush}" Padding="24,16" RowSpacing="0" SizeChanged="Page_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="2" Visibility="Collapsed"/>
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True"><InfoBar.ActionButton><Button x:Name="RetryButton" Content="Retry" Click="Retry_Click"/></InfoBar.ActionButton></InfoBar>
        </StackPanel>
        <ScrollViewer x:Name="WorkspaceScroller" Grid.Row="1" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid x:Name="Workspace" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CalendarColumn" Background="{ThemeResource SurfaceBrush}" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="WeekdayRow" Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="MonthJumpButton" Style="{StaticResource CalendarToolButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" MaxWidth="210">
                                    <Button.Flyout><MenuFlyout x:Name="MonthMenu"/></Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="8"><ContentControl x:Name="MonthIcon" VerticalAlignment="Center"/><TextBlock x:Name="MonthLocation" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource Surface2Brush}" CornerRadius="6" Padding="3"><StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="LargeButton" Style="{StaticResource CalendarToolButton}" Height="28" Padding="10,0" CornerRadius="4" Click="Large_Click"/>
                                        <Button x:Name="CompactButton" Style="{StaticResource CalendarToolButton}" Height="28" Padding="10,0" CornerRadius="4" Click="Compact_Click"/>
                                    </StackPanel></Border>
                                    <Border Background="{ThemeResource LineBrush}" Width="1" Height="20"/>
                                    <Button x:Name="TodayButton" Style="{StaticResource CalendarToolButton}" Width="34" Click="Today_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid x:Name="WeekdayBar" Grid.Row="1" ColumnSpacing="6" Margin="16,0,24,0"/>
                        <Grid x:Name="CalendarViewport" Grid.Row="2" SizeChanged="CalendarViewport_SizeChanged">
                            <ScrollViewer x:Name="MonthScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PointerWheelChanged="Calendar_Wheel" ViewChanged="Calendar_Scrolled" HorizontalContentAlignment="Stretch">
                                <Grid x:Name="MonthsPanel" RowSpacing="10" ColumnSpacing="16" Padding="16,0,16,20" KeyDown="Calendar_KeyDown"/>
                            </ScrollViewer>
                            <Border x:Name="StickyMonthHeader" Height="42" Margin="16,0,24,0" Background="{ThemeResource SurfaceBrush}" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StickyMonthLabel" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StickyMonthSummary" Grid.Column="1" FontSize="13" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectionHint" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <StackPanel x:Name="HeatLegend" Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="DetailScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="DetailPanel" Spacing="12" Background="{ThemeResource BgBrush}" Padding="0,0,0,16"/>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
