<UserControl
    x:Class="Toksight.Desktop.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageRoot" Background="{ThemeResource BgBrush}" Padding="24,16,24,0" RowSpacing="12" SizeChanged="Page_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True">
                <InfoBar.ActionButton><Button x:Name="RetryButton" Content="Retry" Click="Retry_Click"/></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <Grid x:Name="Workspace" Grid.Row="1" ColumnSpacing="16" RowSpacing="16" Background="{ThemeResource BgBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="CalendarColumn" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="TodayButton" Click="Today_Click"/>
                    <ToggleButton x:Name="CompactButton" Click="Compact_Click"/>
                    <ComboBox x:Name="MonthPicker" MinWidth="140" SelectionChanged="Month_Changed"/>
                </StackPanel>
                <TextBlock x:Name="SelectionHint" Grid.Row="1" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                <ScrollViewer x:Name="MonthScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PointerWheelChanged="Calendar_Wheel" ViewChanged="Calendar_Scrolled">
                    <StackPanel x:Name="MonthsPanel" Spacing="16" Padding="0,0,0,16" KeyDown="Calendar_KeyDown"/>
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="DetailScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailPanel" Spacing="16" Background="{ThemeResource BgBrush}" Padding="0,0,0,16"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
