<UserControl
    x:Class="Toksight.Desktop.Views.PricesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource AppFontFamily}">
    <Grid Padding="24,20,24,0" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="FilterPanel" Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="16,12">
            <StackPanel Spacing="12">
                <Grid x:Name="FilterRow" ColumnSpacing="12" SizeChanged="FilterRow_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="SearchFilters" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Grid Width="270" Height="32">
                            <TextBox x:Name="Search" Padding="31,4,10,4" MinHeight="32" TextChanged="Filters_Changed" FontSize="14"/>
                            <ContentControl x:Name="SearchIcon" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <ToggleButton x:Name="UsedOnly" Click="Used_Click" BorderThickness="0" Background="Transparent" Padding="0" MinWidth="0" MinHeight="30" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="Summary" Grid.Column="1" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="PreferencesButton" Click="Preferences_Click" Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0" BorderThickness="0" Background="Transparent"/>
                        <Button x:Name="UpdateButton" Click="Update_Click" Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0" BorderThickness="0" Background="Transparent"/>
                        <Button x:Name="ResetButton" Click="Reset_Click" Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="ProviderChips" Orientation="Horizontal" Spacing="6"/>
                </ScrollViewer>
                <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Visibility="Collapsed" Height="2"/>
            </StackPanel>
        </Border>
        <InfoBar Grid.Row="1" x:Name="Notice" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton><Button x:Name="RetryButton" Click="Retry_Click"/></InfoBar.ActionButton>
        </InfoBar>
        <ListView Grid.Row="2" x:Name="Catalog" SelectionMode="None" HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" Padding="0,0,0,20"
                  ContainerContentChanging="Catalog_ContainerContentChanging" SizeChanged="Catalog_SizeChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/></ControlTemplate></Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate><Grid/></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Border x:Name="EmptyPanel" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource Surface2Brush}" CornerRadius="8" Padding="28" VerticalAlignment="Top">
            <TextBlock x:Name="EmptyMessage" FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
        <Border x:Name="SetupPanel" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="32" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20">
            <StackPanel Spacing="16">
                <Border Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="8" Background="{ThemeResource SignalSoftBrush}"><ContentControl x:Name="SetupIcon" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="SetupHeading" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="SetupDescription" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
                <StackPanel x:Name="SetupSources" Spacing="8"/>
                <CheckBox x:Name="SetupAutoUpdate" IsChecked="True"/>
                <TextBlock x:Name="SetupOfflineNote" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SetupOnlineButton" Click="SetupOnline_Click"/><Button x:Name="SetupLocalButton" Click="SetupLocal_Click"/></StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
