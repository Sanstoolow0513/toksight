<UserControl
    x:Class="Toksight.Desktop.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12" Padding="24,16,24,0" Background="{ThemeResource BgBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True">
                <InfoBar.ActionButton><Button x:Name="RetryButton" Content="Retry" Click="Retry_Click"/></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,0,24">
                <StackPanel x:Name="ReportPanel" Spacing="16" Background="{ThemeResource BgBrush}"/>
                <StackPanel x:Name="QuotaPanel" Spacing="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
