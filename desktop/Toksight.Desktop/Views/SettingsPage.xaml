<UserControl
    x:Class="Toksight.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource AppFontFamily}">
    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/>
            <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Visibility="Collapsed" Height="3"/>
        </StackPanel>
        <InfoBar Grid.Row="1" x:Name="Notice" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton><Button x:Name="RetryButton" Click="Retry_Click"/></InfoBar.ActionButton>
        </InfoBar>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch" Padding="0,0,12,24">
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="AppearanceHeading" FontSize="16" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch" SelectionChanged="Theme_Changed"/>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Language_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="TimezoneHeading" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TimezoneDescription" FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <ComboBox x:Name="ZoneCombo" HorizontalAlignment="Stretch" SelectionChanged="Zone_Changed"/>
                        <TextBlock x:Name="TimezonePreview" FontSize="13" Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="DatabaseHeading" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DatabaseDescription" FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ExportButton" Click="Export_Click"/>
                            <Button x:Name="ImportButton" Click="Import_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="BackupHeading" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BackupDescription" FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBox x:Name="RepoInput" PlaceholderText="owner/private-repository" TextChanged="BackupInput_Changed"/>
                        <PasswordBox x:Name="TokenInput" PasswordChanged="Token_Changed"/>
                        <TextBlock x:Name="TokenHint" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SaveBackupButton" Click="SaveBackup_Click"/>
                            <Button x:Name="ClearTokenButton" Click="ClearToken_Click"/>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource LineBrush}" Margin="0,4"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="GitHub CLI" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GhStatus" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="DetectButton" Click="Detect_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource LineBrush}" Margin="0,4"/>
                        <TextBlock x:Name="RemoteStatus" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock x:Name="LastBackup" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LastRestore" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BackupActionHint" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="UploadButton" Click="Upload_Click"/>
                            <Button x:Name="RestoreButton" Click="Restore_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PrivacyNote" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
