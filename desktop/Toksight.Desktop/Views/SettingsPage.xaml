<UserControl
    x:Class="Toksight.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource AppFontFamily}">
    <Grid Padding="24,16,24,0" RowSpacing="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Visibility="Collapsed" Height="2"/>
        <InfoBar Grid.Row="1" x:Name="Notice" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton><Button x:Name="RetryButton" Click="Retry_Click"/></InfoBar.ActionButton>
        </InfoBar>
        <ScrollViewer x:Name="SettingsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="SettingsScroller_SizeChanged">
            <StackPanel x:Name="SettingsContent" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,12,24">
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4"><ContentControl x:Name="AppearanceIcon" VerticalAlignment="Center"/><TextBlock x:Name="AppearanceHeading" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThemeLabel" FontSize="14" VerticalAlignment="Center"/>
                            <ContentControl x:Name="ThemeSegments" Grid.Column="1" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource LineBrush}"/>
                        <Grid Padding="0,10,0,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" FontSize="14" VerticalAlignment="Center"/>
                            <ContentControl x:Name="LanguageSegments" Grid.Column="1" HorizontalContentAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8"><ContentControl x:Name="TimezoneIcon" VerticalAlignment="Center"/><TextBlock x:Name="TimezoneHeading" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                        <TextBlock x:Name="TimezoneDescription" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ZoneCombo" Width="320" MinHeight="32" HorizontalAlignment="Left" SelectionChanged="Zone_Changed"/>
                            <Border Grid.Column="1" Background="{ThemeResource Surface2Brush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="TimezonePreview" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8"><ContentControl x:Name="DatabaseIcon" VerticalAlignment="Center"/><TextBlock x:Name="DatabaseHeading" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                        <TextBlock x:Name="DatabaseDescription" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="20" Padding="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="ExportLabel" FontSize="14"/><TextBlock x:Name="ExportNote" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            <Button Grid.Column="1" x:Name="ExportButton" Click="Export_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource LineBrush}"/>
                        <Grid ColumnSpacing="20" Padding="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="ImportLabel" FontSize="14"/><TextBlock x:Name="ImportNote" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            <Button Grid.Column="1" x:Name="ImportButton" Click="Import_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8"><ContentControl x:Name="BackupIcon" VerticalAlignment="Center"/><TextBlock x:Name="BackupHeading" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                        <TextBlock x:Name="BackupDescription" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                        <Grid x:Name="BackupFields" ColumnSpacing="12" RowSpacing="10" SizeChanged="BackupFields_SizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox x:Name="RepoInput" PlaceholderText="owner/private-repository" TextChanged="BackupInput_Changed" Width="340" MaxWidth="340" HorizontalAlignment="Left"/>
                            <PasswordBox x:Name="TokenInput" Grid.Column="1" PasswordChanged="Token_Changed" Width="340" MaxWidth="340" HorizontalAlignment="Left"/>
                            <Button x:Name="SaveBackupButton" Grid.Column="2" Click="SaveBackup_Click" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TokenHint" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" x:Name="ClearTokenButton" Click="ClearToken_Click" MinHeight="26" Padding="6,2" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource LineBrush}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="GitHub CLI" FontSize="14"/><TextBlock x:Name="GhStatus" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            <Button Grid.Column="1" x:Name="DetectButton" Click="Detect_Click" VerticalAlignment="Center" MinHeight="28" Padding="8,3" Background="Transparent" BorderThickness="0"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource LineBrush}"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="RemoteStatus" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="LastBackup" FontSize="13" Foreground="{ThemeResource MutedBrush}"/><TextBlock x:Name="LastRestore" FontSize="13" Foreground="{ThemeResource MutedBrush}"/></StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="BackupActionHint" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="UploadButton" Click="Upload_Click"/><Button x:Name="RestoreButton" Click="Restore_Click"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl x:Name="PrivacyIcon" VerticalAlignment="Top"/><TextBlock Grid.Column="1" x:Name="PrivacyNote" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/></Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
