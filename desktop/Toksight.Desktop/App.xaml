<Application x:Class="Toksight.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush" Color="#F3F3F1" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InkBrush" Color="#18181A" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#666669" />
                    <SolidColorBrush x:Key="LineBrush" Color="#1A18181A" />
                    <SolidColorBrush x:Key="SignalBrush" Color="#E8590C" />
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#E8590C" />
                    <Color x:Key="SystemAccentColor">#E8590C</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BgBrush" Color="#111113" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1A1D" />
                    <SolidColorBrush x:Key="InkBrush" Color="#ECECF0" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#B4B4B9" />
                    <SolidColorBrush x:Key="LineBrush" Color="#29ECECF0" />
                    <SolidColorBrush x:Key="SignalBrush" Color="#FF7A2E" />
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF7A2E" />
                    <Color x:Key="SystemAccentColor">#FF7A2E</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BgBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SignalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable</FontFamily>
            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{ThemeResource InkBrush}" /></Style>
            <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="CornerRadius" Value="6" /></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
